# ============================================================================
#  MedScholar Agent 环境变量模板
#
#  使用方式：把本文件复制为 .env 放在项目根目录，填入你的 Key 后无需再改 config.yaml
#      copy .env.example .env
#
#  说明：
#   · .env 已在 .gitignore 中，不会随分享包外泄；但也请勿把填好 Key 的 .env 发给别人
#   · 已存在的系统环境变量优先于 .env，不会被覆盖
#   · 所有 Key 都是**免费申请**的，填写后检索更快更稳
# ============================================================================

# ---------------------------------------------------------------------------
# 学术数据源 API Key（全部可选，但强烈建议填 Semantic Scholar）
# ---------------------------------------------------------------------------

# NCBI / PubMed —— 速率从 3 次/秒 提升到 10 次/秒
# 申请：https://www.ncbi.nlm.nih.gov/account/settings/  （注册后在 Account Settings 页生成）
NCBI_API_KEY=
# NCBI 建议填写联系邮箱（polite pool）
NCBI_EMAIL=

# Semantic Scholar —— 从 100 次/5 分钟 提升到 1000 次/5 分钟
# ⚠️ 不填的话限流很严重（实测会频繁 429），建议务必申请
# 申请：https://www.semanticscholar.org/product/api
S2_API_KEY=

# OpenAlex —— 免费配额提升 10 倍
# 申请：https://openalex.org/  （注册后在 Settings 里生成）
OPENALEX_API_KEY=
# 强烈建议填写邮箱，进入 polite pool，速度与稳定性明显更好
OPENALEX_EMAIL=

# ---------------------------------------------------------------------------
# 推理模型
# ---------------------------------------------------------------------------

# 默认使用本地 Ollama，无需任何 Key。
#
# 若要用云端 DeepSeek（成本极低，质量明显优于本地 8B）：
#   1) 在这里填 DEEPSEEK_API_KEY
#   2) **并且**在 config.yaml 里显式改这三项（三者必须配套）：
#        llm:
#          provider: deepseek
#          model: deepseek-chat          # 换成你所用网关支持的模型名
#          base_url: https://api.deepseek.com/v1
#
# ⚠️ 为什么第 2 步不能省：
#   机器上别的项目把 DEEPSEEK_API_KEY 设成用户级环境变量是很常见的。
#   如果程序因为"看到这个变量"就自动把 provider 切成 deepseek，
#   就会把 config.yaml 里的本地模型名（如 qwen3:8b）发给云端网关，
#   得到一个莫名其妙的 HTTP 400。
#   所以本程序**不会**根据环境变量自动切换后端 —— 后端永远由 config.yaml 决定。
DEEPSEEK_API_KEY=

# 云端网关地址（可选；不填时 provider=deepseek 会使用 api.deepseek.com）
# 自建/公司网关请填这里，例如 https://your-gateway.example.com/v1
# DEEPSEEK_BASE_URL=

# Ollama 服务地址（默认本机；若 Ollama 装在别的机器上可改）
# OLLAMA_HOST=http://127.0.0.1:11434

# ---------------------------------------------------------------------------
# 本地覆盖（一般不需要）
# ---------------------------------------------------------------------------

# 数据目录（默认「项目目录/data」）
# MEDSCHOLAR_DATA_DIR=

# 配置文件路径（默认「数据目录/config.yaml」，其次「项目目录/config.yaml」）
# MEDSCHOLAR_CONFIG=

# 离线模式：true 时完全不联网，只用本地知识库（本地 Ollama 仍可用）
# MEDSCHOLAR_OFFLINE=false

# Web 服务端口（默认 8760）
# MEDSCHOLAR_PORT=8760

# 覆盖模型名
# MEDSCHOLAR_LLM_MODEL=qwen3:8b
# MEDSCHOLAR_EMBED_MODEL=nomic-embed-text:latest
# MEDSCHOLAR_EMBED_PROVIDER=ollama
